{
  "name": "omg-website",
  "version": "0.0.0",
  "private": true,
  "description": "The landing page for Open Model Gateway (OMG), a self-hosted gateway that governs every AI model behind one API",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/sync-screenshots.mjs",
    "og": "node scripts/og-image.mjs",
    "docker": "docker build -t omg-website:dev . && docker run --rm --read-only --tmpfs /tmp:uid=101,gid=101 -p 127.0.0.1:8080:8080 omg-website:dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
